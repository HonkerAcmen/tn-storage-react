# ============================================================
# 模式一：本地开发（Development）
# 用法：复制为 .env.local
#   cp .env.development.example .env.local
# ============================================================
#
# 启动顺序：
#   1. 本机 MySQL + MinIO
#   2. 后端 TNStorage：pnpm start:dev（读取 .env.local，默认 PORT=3002）
#   3. 前端：pnpm dev（http://localhost:3000）
#
# 浏览器访问 http://localhost:3000
# API 走同域 /api/v1，由 Next 开发服务器代理到 NestJS

# 前端请求前缀（与部署/正式模式保持一致，都用相对路径）
NEXT_PUBLIC_API_URL=/api/v1

# 分片上传单次请求超时（毫秒），弱网下建议与后端 UPLOAD_TIMEOUT_MS 一致
NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=300000

# Next 开发代理目标（对应后端 .env.local 里的 PORT；Windows 请用 127.0.0.1）
API_PROXY_TARGET=http://127.0.0.1:3002
