# ============================================================
# 模式三：正式环境（Production）
# 用法：在 CI/CD 或服务器构建前端时注入
# Docker 构建见 TNStorage/.env.production.example
# ============================================================
#
# 浏览器通过 https://你的域名 访问，Nginx 同域反代 /api/v1
# 不要写死后端 IP，统一用相对路径

NEXT_PUBLIC_API_URL=/api/v1
# 头像分片单片大小（字节），须与后端 AVATAR_CHUNK_SIZE 一致
NEXT_PUBLIC_AVATAR_CHUNK_SIZE=524288
