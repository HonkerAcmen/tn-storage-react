# ============================================================
# 模式二：Docker 部署 / 验收（Deployment）
# 用法：一般无需在本仓库单独配置；由 TNStorage 的 docker compose 构建前端
# 若在本地手动 docker build 前端镜像，可注入：
#   docker build --build-arg NEXT_PUBLIC_API_URL=/api/v1 -t tn-web .
# ============================================================
#
# 浏览器访问 http://localhost（Nginx 80），API 同域 /api/v1
# 环境变量写在 TNStorage/.env（见 TNStorage/.env.example）

NEXT_PUBLIC_API_URL=/api/v1
